#: src/Gateway/Gateway.php:140
msgid "bunq payment gateway for WooCommerce"
msgstr "bunq-Zahlungsgateway für WooCommerce"

#: src/Gateway/PaymentMethods.php:28
msgid "Credit or Debit Card"
msgstr "Kredit- oder Debitkarte"

#: src/Gateway/PaymentMethods.php:35
msgid "iDEAL"
msgstr "iDEAL"

#: src/Gateway/PaymentMethods.php:42
msgid "Bancontact"
msgstr "Bancontact"

#: src/Gateway/PaymentMethods.php:49
msgid "From a bunq account"
msgstr "Von einem bunq-Konto"

#: src/Gateway/Gateway.php:239
msgid ""
"bunq authorization completed. Select your bank account and save the "
"settings."
msgstr ""
"bunq-Autorisierung abgeschlossen. Wählen Sie Ihr Bankkonto aus und speichern"
" Sie die Einstellungen."

#: src/Gateway/Gateway.php:306
msgid "Payment method invalid"
msgstr "Ungültige Zahlungsmethode"

#. translators: %s: link to the WooCommerce log page
#: src/Gateway/Gateway.php:324
msgid "Details are logged in %s (source: bunq)."
msgstr "Details werden in %s protokolliert (Quelle: bunq)."

#: src/Gateway/Gateway.php:325
msgid "WooCommerce > Status > Logs"
msgstr "WooCommerce > Status > Protokolle"

#: src/Gateway/Gateway.php:346
msgid "OAuth Authorization Request"
msgstr "OAuth-Autorisierungsanfrage"

#: src/Gateway/Gateway.php:351
msgid "Refresh bank accounts"
msgstr "Bankkonten aktualisieren"

#: src/Gateway/SettingsFields.php:63
msgid "Enable/Disable"
msgstr "Aktivieren/Deaktivieren"

#: src/Gateway/SettingsFields.php:64
msgid "Enable bunq Gateway"
msgstr "bunq-Gateway aktivieren"

#: src/Gateway/SettingsFields.php:70
msgid "Test mode"
msgstr "Testmodus"

#: src/Gateway/SettingsFields.php:71
msgid "Enable Test Mode"
msgstr "Testmodus aktivieren"

#: src/Gateway/SettingsFields.php:73
msgid "Place the payment gateway in test mode using test API keys."
msgstr ""
"Das Zahlungsgateway mit Test-API-Schlüsseln in den Testmodus versetzen."

#: src/Gateway/SettingsFields.php:78
msgid "Title"
msgstr "Titel"

#: src/Gateway/SettingsFields.php:80
msgid "This controls the title which the user sees during checkout."
msgstr "Dieser Titel wird dem Kunden beim Bezahlvorgang angezeigt."

#: src/Gateway/SettingsFields.php:81
msgid "iDEAL, Credit Card or Bancontact"
msgstr "iDEAL, Kreditkarte oder Bancontact"

#: src/Gateway/SettingsFields.php:85
msgid "Description"
msgstr "Beschreibung"

#: src/Gateway/SettingsFields.php:87
msgid "This controls the description which the user sees during checkout."
msgstr "Diese Beschreibung wird dem Kunden beim Bezahlvorgang angezeigt."

#: src/Gateway/SettingsFields.php:88
msgid "Pay with iDEAL, Credit Card or Bancontact"
msgstr "Bezahlen mit iDEAL, Kreditkarte oder Bancontact"

#: src/Gateway/SettingsFields.php:91
msgid "Bank account"
msgstr "Bankkonto"

#: src/Gateway/SettingsFields.php:96
msgid "Direct Gateway"
msgstr "Direktes Gateway"

#: src/Gateway/SettingsFields.php:97
msgid "Enable direct gateway"
msgstr "Direktes Gateway aktivieren"

#: src/Gateway/SettingsFields.php:100
msgid ""
"Allow your customers to directly select a payment method from the checkout "
"page."
msgstr ""
"Kunden können die Zahlungsmethode direkt auf der Kassenseite auswählen."

#: src/Gateway/SettingsFields.php:32
msgid "Payment methods"
msgstr "Zahlungsmethoden"

#: src/Gateway/SettingsFields.php:114
msgid "Test OAuth Client ID"
msgstr "Test OAuth Client ID"

#: src/Gateway/SettingsFields.php:118
msgid "Test OAuth Client Secret"
msgstr "Test OAuth Client Secret"

#: src/Gateway/SettingsFields.php:132
msgid "OAuth Client ID"
msgstr "OAuth Client ID"

#: src/Gateway/SettingsFields.php:136
msgid "OAuth Client Secret"
msgstr "OAuth Client Secret"

#. translators: %s: bunq payment request id
#: src/Gateway/Gateway.php:667
msgid "bunq payment request %s created"
msgstr "bunq-Zahlungsanfrage %s erstellt"

#: src/Gateway/Gateway.php:690
msgid ""
"The payment could not be started with bunq. Please try again or choose "
"another payment method."
msgstr ""
"Die Zahlung konnte bei bunq nicht gestartet werden. Bitte versuchen Sie es "
"erneut oder wählen Sie eine andere Zahlungsmethode."

#: src/Gateway/Gateway.php:709
msgid "This order has no bunq payment that can be refunded."
msgstr "Diese Bestellung hat keine bunq-Zahlung, die erstattet werden kann."

#: src/Gateway/Gateway.php:713
msgid "The refund amount must be greater than zero."
msgstr "Der Erstattungsbetrag muss größer als null sein."

#: src/Gateway/Gateway.php:729
msgid ""
"The bunq payment for this order has no IBAN to refund to (for example a card"
" payment). Refund it from the bunq app instead."
msgstr ""
"Die bunq-Zahlung dieser Bestellung hat keine IBAN für die Erstattung (zum "
"Beispiel eine Kartenzahlung). Erstatten Sie sie stattdessen über die bunq-"
"App."

#. translators: 1: order number, 2: shop name
#: src/Gateway/Gateway.php:734
msgid "Refund order %1$s %2$s"
msgstr "Erstattung Bestellung %1$s %2$s"

#. translators: 1: refunded amount, 2: bunq draft payment id
#: src/Gateway/Gateway.php:759
msgid ""
"bunq refund of %1$s created as draft payment %2$s. Approve it in the bunq "
"app to send the money."
msgstr ""
"bunq-Erstattung von %1$s als Zahlungsentwurf %2$s angelegt. Bestätigen Sie "
"ihn in der bunq-App, um das Geld zu senden."

#. translators: %s: error message from bunq
#: src/Gateway/Gateway.php:774
msgid "bunq refund failed: %s"
msgstr "bunq-Erstattung fehlgeschlagen: %s"

#. translators: %s: bunq payment id
#: src/Gateway/Gateway.php:863
msgid "bunq payment %s received"
msgstr "bunq-Zahlung %s erhalten"

#. translators: 1: bunq payment id, 2: amount received, 3: order total
#: src/Gateway/Gateway.php:886
msgid ""
"bunq payment %1$s of %2$s received, but the order total is %3$s. Check the "
"payment before processing the order."
msgstr ""
"bunq-Zahlung %1$s über %2$s erhalten, aber der Bestellwert beträgt %3$s. "
"Prüfen Sie die Zahlung, bevor Sie die Bestellung bearbeiten."

#. translators: 1: bunq payment request id, 2: status reported by bunq
#: src/Gateway/Gateway.php:908
msgid "bunq payment request %1$s is %2$s"
msgstr "bunq-Zahlungsanfrage %1$s ist %2$s"

#: src/Bunq/ApiClient.php:199
msgid "API key not valid or not setup yet"
msgstr "API-Schlüssel ungültig oder noch nicht eingerichtet"

#: src/Bunq/ApiClient.php:203
msgid "Select a bank account"
msgstr "Bankkonto auswählen"

#: src/Bunq/ApiClient.php:216
msgid "(Joint)"
msgstr "(Gemeinschaftskonto)"

#. translators: %s: error message from bunq
#: src/Bunq/ApiClient.php:228
msgid "Error: %s"
msgstr "Fehler: %s"

#. translators: %s: bunq payment request id
#: src/Orders/PaymentMonitor.php:298
msgid "bunq payment request %s cancelled"
msgstr "bunq-Zahlungsanfrage %s storniert"

#: src/Requirements.php:122
msgid "cannot be activated due to incompatible environment."
msgstr "kann nicht aktiviert werden, da die Umgebung nicht kompatibel ist."

#: src/Gateway/Gateway.php:505
msgid "Saved. Enter a new value to replace it."
msgstr "Gespeichert. Geben Sie einen neuen Wert ein, um ihn zu ersetzen."

#: src/Gateway/SettingsFields.php:43
msgid "bunq connection"
msgstr "bunq-Verbindung"

#: src/Gateway/SettingsFields.php:46
msgid "Connected to bunq."
msgstr "Mit bunq verbunden."

#: src/Gateway/SettingsFields.php:47
msgid ""
"Not connected to bunq yet. Save the OAuth Client ID and Client Secret, then "
"click \"OAuth Authorization Request\"."
msgstr ""
"Noch nicht mit bunq verbunden. Speichern Sie die OAuth Client ID und das "
"Client Secret und klicken Sie dann auf „OAuth-Autorisierungsanfrage“."
