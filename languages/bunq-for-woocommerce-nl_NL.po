#: src/Blocks/CheckoutIntegration.php:103
msgid "Payment method"
msgstr "Betaalmethode"

#: src/Bunq/ApiClient.php:119
msgid "PHP's OPcache on this server removes code comments (opcache.save_comments=0), which the bunq SDK needs to read bunq's responses. Ask your hosting provider to set opcache.save_comments=1, then click \"Connect to bunq\" again."
msgstr "De OPcache van PHP op deze server verwijdert commentaar uit de code (opcache.save_comments=0), en dat heeft de bunq SDK nodig om de antwoorden van bunq te lezen. Vraag je hostingprovider om opcache.save_comments=1 in te stellen en klik daarna opnieuw op \"Koppelen met bunq\"."

#: src/Bunq/ApiClient.php:224
msgid "Connect your bunq account first"
msgstr "Koppel eerst je bunq-rekening"

#: src/Bunq/ApiClient.php:228
msgid "Select a bank account"
msgstr "Selecteer een bankrekening"

#: src/Bunq/ApiClient.php:241
msgid "(Joint)"
msgstr "(Gezamenlijk)"

#. translators: %s: error message from bunq
#: src/Bunq/ApiClient.php:253
msgid "Error: %s"
msgstr "Fout: %s"

#: src/Gateway/Gateway.php:146
msgid "bunq payment gateway for WooCommerce"
msgstr "bunq betaalgateway voor WooCommerce"

#: src/Gateway/Gateway.php:265
msgid "bunq authorization completed. Select your bank account and save the settings."
msgstr "bunq-autorisatie voltooid. Selecteer je bankrekening en sla de instellingen op."

#: src/Gateway/Gateway.php:332
msgid "Payment method invalid"
msgstr "Ongeldige betaalmethode"

#: src/Gateway/Gateway.php:447
msgid "You are not allowed to do this."
msgstr "Je mag dit niet doen."

#: src/Gateway/Gateway.php:478
msgid "Disconnected from the bunq sandbox. To also revoke the access at bunq, remove the connection in the bunq app."
msgstr "Ontkoppeld van de bunq-sandbox. Verwijder de koppeling in de bunq-app om de toegang ook bij bunq in te trekken."

#: src/Gateway/Gateway.php:479
msgid "Disconnected from bunq. To also revoke the access at bunq, remove the connection in the bunq app."
msgstr "Ontkoppeld van bunq. Verwijder de koppeling in de bunq-app om de toegang ook bij bunq in te trekken."

#: src/Gateway/Gateway.php:497
msgid "Enter the Client ID and Client Secret of your bunq OAuth client, then click \"Connect to bunq\"."
msgstr "Vul de Client ID en Client Secret van je bunq OAuth-client in en klik daarna op \"Koppelen met bunq\"."

#: src/Gateway/Gateway.php:687
msgid "Saved. Leave empty to keep it, or paste a new secret to replace it."
msgstr "Opgeslagen. Laat leeg om het te behouden, of plak een nieuw secret om het te vervangen."

#: src/Gateway/Gateway.php:786
msgid "bunq rejected the saved connection. Connect again."
msgstr "bunq heeft de opgeslagen koppeling geweigerd. Koppel opnieuw."

#: src/Gateway/Gateway.php:803
msgid "Refresh bank accounts"
msgstr "Bankrekeningen vernieuwen"

#. translators: %s: bunq payment request id
#: src/Gateway/Gateway.php:856
msgid "bunq payment request %s created"
msgstr "bunq-betaalverzoek %s aangemaakt"

#: src/Gateway/Gateway.php:879
msgid "The payment could not be started with bunq. Please try again or choose another payment method."
msgstr "De betaling kon niet worden gestart bij bunq. Probeer het opnieuw of kies een andere betaalmethode."

#: src/Gateway/Gateway.php:898
msgid "This order has no bunq payment that can be refunded."
msgstr "Deze bestelling heeft geen bunq-betaling die terugbetaald kan worden."

#: src/Gateway/Gateway.php:902
msgid "The refund amount must be greater than zero."
msgstr "Het terugbetaalbedrag moet groter zijn dan nul."

#: src/Gateway/Gateway.php:918
msgid "The bunq payment for this order has no IBAN to refund to (for example a card payment). Refund it from the bunq app instead."
msgstr "De bunq-betaling van deze bestelling heeft geen IBAN om naar terug te betalen (bijvoorbeeld een kaartbetaling). Betaal terug vanuit de bunq-app."

#. translators: 1: order number, 2: shop name
#: src/Gateway/Gateway.php:923
msgid "Refund order %1$s %2$s"
msgstr "Terugbetaling bestelling %1$s %2$s"

#. translators: 1: refunded amount, 2: bunq draft payment id
#: src/Gateway/Gateway.php:948
msgid "bunq refund of %1$s created as draft payment %2$s. Approve it in the bunq app to send the money."
msgstr "bunq-terugbetaling van %1$s aangemaakt als conceptbetaling %2$s. Keur deze goed in de bunq-app om het geld te versturen."

#. translators: %s: error message from bunq
#: src/Gateway/Gateway.php:963
msgid "bunq refund failed: %s"
msgstr "bunq-terugbetaling mislukt: %s"

#. translators: %s: bunq payment id
#: src/Gateway/Gateway.php:1052
msgid "bunq payment %s received"
msgstr "bunq-betaling %s ontvangen"

#. translators: 1: bunq payment id, 2: amount received, 3: order total
#: src/Gateway/Gateway.php:1075
msgid "bunq payment %1$s of %2$s received, but the order total is %3$s. Check the payment before processing the order."
msgstr "bunq-betaling %1$s van %2$s ontvangen, maar het bestelbedrag is %3$s. Controleer de betaling voordat je de bestelling verwerkt."

#. translators: 1: bunq payment request id, 2: status reported by bunq
#: src/Gateway/Gateway.php:1097
msgid "bunq payment request %1$s is %2$s"
msgstr "bunq-betaalverzoek %1$s is %2$s"

