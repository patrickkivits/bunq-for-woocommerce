{
    "description": "Development dependencies for the test suite. Kept apart from the root composer.json because the root vendor/ directory is committed and shipped in the plugin zip.",
    "config": {
        "platform-check": false,
        "platform": {
            "php": "7.3.0"
        },
        "allow-plugins": {
            "composer/installers": true,
            "roots/wordpress-core-installer": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org",
            "only": [
                "wpackagist-plugin/*"
            ]
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^1.1",
        "wp-phpunit/wp-phpunit": "^6.8",
        "roots/wordpress-no-content": "^6.8",
        "wpackagist-plugin/woocommerce": "^11.1",
        "composer/installers": "^2.3",
        "roots/wordpress-core-installer": "^1.100"
    },
    "extra": {
        "wordpress-install-dir": "wordpress",
        "installer-paths": {
            "wp-content/plugins/{$name}/": [
                "type:wordpress-plugin"
            ]
        }
    }
}
